{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unitedservices-recruitingwebsite",
  "compatibility_date": "2025-09-23",
  "assets": {
    "directory": "./public",
    // Multi-page static site, not an SPA: unknown paths must return a real 404
    // so search engines don't index every typo'd URL as a copy of the homepage.
    "not_found_handling": "404-page"
  }
}
